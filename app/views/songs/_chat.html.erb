<%# The conversation about the song in the right sidebar. Claude knows the
    sheet, the arrangement and the riffs, not the lyrics, and says what to put
    into the editor; the answers come in over the song's chat stream. %>
<%= turbo_stream_from song, :chat %>
<section id="chat" data-controller="chat" class="flex h-full min-h-0 flex-col">
  <h2 class="text-3xl">Mit Claude reden</h2>
  <p class="mt-1 text-muted">Über <%= song.display_title %>: Akkorde, Ablauf, Groove. Den Songtext bekommt Claude nicht.</p>
  <div id="chat_messages" data-chat-target="messages" class="mt-5 min-h-0 flex-1 space-y-4 overflow-y-auto pr-1">
    <%= render partial: "song_messages/message", collection: song.messages.order(:id), as: :message %>
  </div>
  <div id="chat_thinking"></div>
  <%# Kept across page refreshes, so a question being typed survives the
      song changing underneath; one per song, so it never posts to another. %>
  <div id="chat_form_<%= song.id %>" data-turbo-permanent>
    <%= render "songs/chat_form", song: song %>
  </div>
</section>
