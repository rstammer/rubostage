<% field = "field mt-2 w-full px-3 py-2 text-lg" %>
<% label = "eyebrow block" %>
<% card = "sheet p-5 sm:p-7" %>

<% if @editor.error %>
  <p class="sheet mt-8 flex items-center gap-3 px-5 py-4 text-lg">
    <span class="lamp lamp-on" aria-hidden="true"></span>Nicht gespeichert: <%= @editor.error %>
  </p>
<% end %>

<%= form_with data: {controller: "reveal form-order"}, url: (@song.new_record? ? songs_path : song_path(@song)), method: (@song.new_record? ? :post : :patch), scope: :song, class: "mt-10 space-y-6" do %>
  <%= hidden_field_tag "song[origin]", "manual", id: nil if @song.new_record? %>
  <section class="<%= card %> grid gap-5 sm:grid-cols-2">
    <div>
      <%= label_tag "song_title", "Titel", class: label %>
      <%= text_field_tag "song[title]", @editor.title, id: "song_title", class: field %>
    </div>
    <div>
      <%= label_tag "song_artist", "Band", class: label %>
      <%= text_field_tag "song[artist]", @editor.artist, id: "song_artist", class: field %>
    </div>
    <div class="grid grid-cols-3 gap-5">
      <div>
        <%= label_tag "song_key", "Tonart", class: label %>
        <%= text_field_tag "song[key]", @editor.key, id: "song_key", class: field %>
      </div>
      <div>
        <%= label_tag "song_bpm", "BPM", class: label %>
        <%= number_field_tag "song[bpm]", @editor.bpm, id: "song_bpm", min: SongSheet::BPM_RANGE.min, max: SongSheet::BPM_RANGE.max, class: field %>
      </div>
      <div>
        <%= label_tag "song_beats", "Takt", class: label %>
        <%= select_tag "song[beats]", options_for_select({"4/4" => 4, "2/4" => 2}, @editor.beats), id: "song_beats", class: field,
              title: "2/4: Die Akkorde wechseln alle zwei Schläge, die Band spielt ruhig im Vierertakt weiter." %>
      </div>
    </div>
  </section>

  <%# The form as a row of keys: drag them into order, × takes one out, the
      sections below add one at the end. The server still gets the names in
      a comma list, through the hidden field. %>
  <section class="<%= card %>">
    <p class="<%= label %>">Ablauf</p>
    <%= hidden_field_tag "song[form]", @editor.form, id: "song_form", data: {form_order_target: "input"} %>
    <ol class="mt-3 flex min-h-12 flex-wrap gap-2" data-form-order-target="list"
        data-action="dragover->form-order#over drop->form-order#dropped">
      <% @editor.form.split(",").map(&:strip).reject(&:empty?).each do |part| %>
        <%= render "songs/form_key", name: part %>
      <% end %>
    </ol>
    <p class="mt-2 text-muted" data-form-order-target="empty" <%= "hidden" if @editor.form.present? %>>Noch leer – unten einen Teil anklicken.</p>
    <template data-form-order-target="template"><%= render "songs/form_key", name: "" %></template>
    <div class="mt-4 flex flex-wrap items-center gap-2" data-form-order-target="palette">
      <span class="eyebrow mr-1">Hinzufügen:</span>
      <% @editor.rows.reject(&:blank?).map(&:name).uniq.each do |part| %>
        <button type="button" class="ring-button !px-3 !py-1 !text-base" data-action="form-order#add" data-name="<%= part %>">+ <%= part %></button>
      <% end %>
    </div>
    <p class="mt-2 text-muted">Ziehen zum Umsortieren, × entfernt. Neue Abschnitte unten anlegen, dann tauchen sie hier auf.</p>
  </section>

  <section class="<%= card %> grid gap-5 sm:grid-cols-2">
    <div>
      <%= label_tag "song_tuning", "Stimmung der Tabs", class: label %>
      <%= select_tag "song[tuning]", options_for_select(
            {"Standard (E A D G B E)" => "standard", "Drop D" => "drop_d",
             "Halbton tiefer (Eb)" => "half_down", "D-Standard" => "d_standard"}, @editor.tuning),
            id: "song_tuning", class: field %>
    </div>
    <div>
      <%= label_tag "song_tone", "Klang der Riffs", class: label %>
      <%= select_tag "song[tone]", options_for_select({"Verzerrt" => "crunch", "Clean" => "clean"}, @editor.tone),
            id: "song_tone", class: field %>
    </div>
    <p class="text-muted sm:col-span-2">
      Ein Zeichen ist eine Sechzehntel, ein Takt hat 16 Zeichen zwischen zwei <code>|</code>. Oben steht die hohe Saite.
      Zahl = Bund, <code>x</code> = gedämpft, <code>-</code> = klingen lassen. Längere Riffs als weiterer Block von sechs Zeilen.
      Ein Riff wiederholt sich, bis sein Teil zu Ende ist.
    </p>
  </section>

  <section class="<%= card %>">
    <%= label_tag "song_lyrics", "Songtext", class: label %>
    <%= text_area_tag "song[lyrics]", @editor.lyrics, id: "song_lyrics", rows: 10, class: "#{field} leading-relaxed",
          placeholder: "Text hier hineinkopieren – Zeilen und Leerzeilen bleiben, wie sie sind." %>
    <p class="mt-1 text-muted">Steht auf der Songseite links. Bleibt in der App: nicht im Song-Ordner, nicht bei der KI.</p>
  </section>

  <% @editor.rows.each_with_index do |row, i| %>
    <% name = ->(attr) { "song[sections][#{i}][#{attr}]" } %>
    <% id = ->(attr) { "section_#{i}_#{attr}" } %>
    <section class="<%= card %>">
      <%= hidden_field_tag name.call(:original), row.original, id: nil %>
      <div class="grid gap-5 sm:grid-cols-[1fr_2fr]">
        <div>
          <%= label_tag id.call(:name), row.original.present? ? "Abschnitt" : "Neuer Abschnitt", class: label %>
          <%= text_field_tag name.call(:name), row.name, id: id.call(:name), class: "#{field} font-semibold",
                placeholder: ("z. B. Bridge" if row.original.blank?),
                data: {form_order_target: "section", action: "focus->form-order#remember change->form-order#renamed input->form-order#sections"} %>
          <% if row.original.present? %>
            <p class="mt-1 text-muted">Name und Akkorde leeren entfernt den Abschnitt.</p>
          <% end %>
        </div>
        <div>
          <%= label_tag id.call(:chords), "Akkorde", class: label %>
          <%= text_area_tag name.call(:chords), row.chords, id: id.call(:chords), rows: 2, class: field,
                placeholder: "Am | F | C G | G" %>
          <p class="mt-1 text-muted">Takte mit <code>|</code> oder Zeilenumbruch, zwei Akkorde in einem Takt mit Leerzeichen. Ein leerer Takt oder <code>%</code> lässt den Akkord davor weiterklingen.</p>
        </div>
      </div>

      <% if @editor.arranged? %>
        <div class="mt-5 grid grid-cols-2 gap-5 sm:grid-cols-5">
          <div>
            <%= label_tag id.call(:energy), "Energie", class: label %>
            <%= select_tag name.call(:energy), options_for_select({"1 leise" => 1, "2 mittel" => 2, "3 voll" => 3}, row.energy || 2),
                  id: id.call(:energy), class: field %>
          </div>
          <div>
            <%= label_tag id.call(:groove), "Groove", class: label %>
            <%= select_tag name.call(:groove), options_for_select(
                  DrumGroove::NAMES.map(&:to_s) + (row.groove == "custom" ? ["custom"] : []), row.groove || "rock"),
                  id: id.call(:groove), class: field %>
          </div>
          <div>
            <%= label_tag id.call(:guitar), "Gitarre", class: label %>
            <%= select_tag name.call(:guitar), options_for_select(
                  {"Powerchords" => "power", "Palm Mutes" => "palm", "Offen geschlagen" => "strum", "Stabs" => "stabs", "keine" => "none"},
                  row.guitar || "strum"), id: id.call(:guitar), class: field %>
          </div>
          <div>
            <%= label_tag id.call(:swing), "Swing", class: label %>
            <%= number_field_tag name.call(:swing), row.swing || 0, id: id.call(:swing), min: 0, max: Arrangement::Part::MAX_SWING, step: 0.01, class: field %>
          </div>
          <div class="flex items-end pb-3">
            <%= hidden_field_tag name.call(:fill), "0", id: nil %>
            <label class="flex items-center gap-3 text-lg">
              <%= check_box_tag name.call(:fill), "1", row.fill, id: id.call(:fill), class: "size-5 accent-accent" %>
              Fill am Ende
            </label>
          </div>
        </div>
      <% end %>

      <% tuning = @editor.tuning.presence_in(Tab::TUNINGS.keys) || "standard" %>
      <% riffs = [
           {box: :riff_guitar, field: :tab, title: "Gitarre", text: row.tab, labels: Tab.labels(tuning), rows: 7},
           {box: :riff_bass, field: :bass_tab, title: "Bass", text: row.bass_tab, labels: Tab.labels(tuning, bass: true), rows: 5}
         ] %>
      <div class="mt-5">
        <p class="<%= label %>">Riff</p>
        <div class="mt-2 flex flex-wrap gap-x-6 gap-y-2">
          <% riffs.each do |riff| %>
            <label class="flex items-center gap-3 text-lg">
              <%= hidden_field_tag name.call(riff[:box]), "0", id: nil %>
              <%= check_box_tag name.call(riff[:box]), "1", riff[:text].present?, id: id.call(riff[:box]),
                    class: "size-5 accent-accent", data: {action: "reveal#toggle", reveal_panel_param: id.call(riff[:field])} %>
              <%= riff[:title] %>
            </label>
          <% end %>
        </div>
        <% riffs.each do |riff| %>
          <div id="<%= id.call(riff[:field]) %>_panel" class="mt-4" <%= "hidden" if riff[:text].blank? %>
               data-controller="tab" data-tab-strings-value="<%= riff[:labels].to_json %>">
            <div class="flex items-center justify-between gap-3">
              <%= label_tag id.call(riff[:field]), "#{riff[:title]} (#{riff[:labels].join(" ")})", class: label %>
              <button type="button" class="ring-button !px-4 !py-1 !text-base" data-action="tab#addBar">+ Takt</button>
            </div>
            <%= text_area_tag name.call(riff[:field]), riff[:text], id: id.call(riff[:field]), rows: riff[:rows], wrap: "off", spellcheck: false,
                  class: "#{field} overflow-x-auto font-mono text-base leading-snug whitespace-pre",
                  data: {tab_target: "input", action: "input->tab#check"} %>
            <p class="mt-1 text-muted" data-tab-target="status" aria-live="polite"></p>
          </div>
        <% end %>
      </div>
    </section>
  <% end %>

  <div class="flex flex-wrap justify-end gap-3">
    <%= link_to "Abbrechen", (@song.new_record? ? root_path : song_path(@song)), class: "ring-button" %>
    <button type="submit" class="ring-button button-go">Speichern</button>
  </div>
<% end %>
