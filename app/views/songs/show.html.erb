<% content_for :title, "#{@song.display_title} – rubostage" %>
<%= turbo_stream_from @song %>

<% if @song.pending? %>
  <p class="flex items-center gap-3 text-lg text-muted"><span class="lamp lamp-blink" aria-hidden="true"></span>Wird geschrieben</p>
  <h1 class="mt-4 text-6xl leading-[0.95] sm:text-8xl"><%= @song.request %></h1>
  <p class="mt-6 max-w-xl text-xl leading-relaxed text-muted">
    Tonart, Tempo und Akkorde werden gerade nachgeschlagen. Sobald sie da sind, startet das Play-Along von selbst.
  </p>

<% elsif @song.failed? %>
  <p class="flex items-center gap-3 text-lg text-muted"><span class="lamp lamp-on" aria-hidden="true"></span>Hat nicht geklappt</p>
  <h1 class="mt-4 text-6xl leading-[0.95] sm:text-8xl"><%= @song.request %></h1>
  <p class="sheet mt-8 max-w-2xl px-5 py-4 text-lg"><%= @song.error %></p>
  <div class="mt-8 flex flex-wrap gap-3">
    <%= link_to "Anderen Song nennen", root_path, class: "ring-button" %>
    <%= button_to "Löschen", song_path(@song), method: :delete, class: "ring-button",
          form: {data: {turbo_confirm: "#{@song.display_title} wirklich löschen?"}} %>
  </div>

<% else %>
  <% sheet = @song.lead_sheet %>
  <div data-controller="hotkeys">
  <div class="flex flex-wrap items-end justify-between gap-x-10 gap-y-6">
    <div class="min-w-0">
      <p class="text-xl text-muted"><%= sheet.artist %></p>
      <h1 class="mt-1 text-6xl leading-[0.95] sm:text-8xl"><%= sheet.title %></h1>
    </div>
    <dl class="flex gap-8">
      <div>
        <dt class="silk text-muted">Tonart</dt>
        <dd class="font-display text-4xl"><%= sheet.key %></dd>
      </div>
      <div>
        <dt class="silk text-muted">Tempo</dt>
        <dd class="font-display text-4xl"><%= sheet.bpm %> <span class="font-sans text-lg font-normal">bpm</span></dd>
      </div>
      <div>
        <dt class="silk text-muted">Sound</dt>
        <dd class="mt-2 flex items-center gap-2 text-lg">
          <span class="lamp <%= {"pending" => "lamp-blink", "ready" => "lamp-on"}[@song.arrangement_status] %>" aria-hidden="true"></span>
          <%= {"none" => "Einfacher Groove", "pending" => "Arrangement kommt",
               "ready" => "Volles Arrangement", "failed" => "Einfacher Groove"}[@song.arrangement_status] %>
        </dd>
      </div>
    </dl>
  </div>

  <%= turbo_stream_from @song, :now %>
  <section class="mt-10">
    <%# The wrapper keeps the live panel when the page refreshes, e.g. as the
        arrangement arrives. The panel itself must not be permanent: Turbo
        would then ignore the streams that replace it. %>
    <div id="now_playing_frame" data-turbo-permanent>
      <%= render "songs/now", now: NowPlaying.new(@song, nil) %>
    </div>

    <div class="mt-10 flex flex-wrap items-start gap-x-6 gap-y-6">
      <%= button_to song_playback_path(@song), class: "footswitch footswitch-go", data: {hotkey: "p"} do %>
        <%= footswitch_cap(:play) %>Spielen
      <% end %>
      <%= button_to playback_path, method: :delete, class: "footswitch", data: {hotkey: "s escape"} do %>
        <%= footswitch_cap(:stop) %>Stopp
      <% end %>
      <%= button_to song_command_path(@song, kind: "repeat"), class: "footswitch", data: {hotkey: "r"} do %>
        <%= footswitch_cap(:repeat) %>Nochmal
      <% end %>
      <%= button_to song_command_path(@song, kind: "next"), class: "footswitch", data: {hotkey: "n arrowright"} do %>
        <%= footswitch_cap(:next) %>Weiter
      <% end %>
      <%= button_to song_command_path(@song, kind: "end"), class: "footswitch", data: {hotkey: "e"} do %>
        <%= footswitch_cap(:end) %>Schluss
      <% end %>
      <p id="queued" class="self-center text-lg" aria-live="polite" data-turbo-permanent></p>
    </div>
  </section>

  <section class="mt-14">
    <h2 class="text-3xl">Ablauf</h2>
    <p class="text-muted">Antippen springt dorthin, wenn der laufende Teil zu Ende ist.</p>
    <ol class="mt-4 flex flex-wrap gap-3">
      <% sheet.form.each_with_index do |name, i| %>
        <li>
          <%= button_to song_command_path(@song, kind: "jump", position: i), id: "form-#{i}",
                class: "ring-button form-key", data: ({hotkey: (i + 1).to_s} if i < 9) do %>
            <span class="lamp" aria-hidden="true"></span><%= name %>
          <% end %>
        </li>
      <% end %>
    </ol>
  </section>

  <section class="mt-14 grid gap-6 md:grid-cols-2">
    <% sheet.sections.each_with_index do |section, section_index| %>
      <article class="sheet p-5 sm:p-7">
        <h3 class="text-2xl"><%= section.name %></h3>
        <div class="mt-3 grid grid-cols-4 border-l-2 border-ink/25">
          <% position = 0 %>
          <% section.bars.each do |bar| %>
            <div class="flex min-w-0 flex-wrap items-baseline gap-x-2 border-r-2 border-ink/25 px-2 py-3 font-display text-3xl sm:px-3 xl:text-4xl">
              <% bar.each do |chord| %>
                <span id="chord-<%= section_index %>-<%= position %>"><%= chord %></span>
                <% position += 1 %>
              <% end %>
            </div>
          <% end %>
        </div>
      </article>
    <% end %>
  </section>

  <% unless @song.arrangement_status == "pending" %>
    <% again = @song.arrangement.present? %>
    <section class="sheet mt-14 p-5 sm:p-7">
      <h2 class="text-3xl"><%= again ? "Neu arrangieren" : "Arrangieren lassen" %></h2>
      <p class="text-muted">
        <%= again ? "Die KI schreibt die Band neu. Was du an Energie, Groove und Gitarre eingestellt hast, ist danach weg." :
              "Die KI schreibt aus Tonart, Tempo und Akkorden die Band: Schlagzeug, Bass, Gitarre und Flächen." %>
      </p>
      <%= form_with url: song_arrangement_path(@song), class: "mt-4 flex flex-wrap items-end gap-4",
            data: ({turbo_confirm: "Das jetzige Arrangement wird ersetzt. Weiter?"} if again) do %>
        <div class="min-w-64 flex-1">
          <%= label_tag "wish", "Wunsch (optional)", class: "eyebrow block" %>
          <%= text_field_tag "wish", nil, autocomplete: "off", class: "field mt-2 w-full px-3 py-2 text-lg",
                placeholder: "z. B. ruhiger, Reggae im Refrain, ohne Fläche" %>
        </div>
        <button type="submit" class="ring-button button-go"><%= again ? "Neu arrangieren" : "Arrangieren lassen" %></button>
      <% end %>
    </section>
  <% end %>

  <div class="mt-14 flex flex-wrap items-center justify-between gap-6 border-t-2 border-ink/20 pt-6">
    <div class="max-w-2xl text-muted">
      <p>
        Tasten: P spielen, S stopp, R nochmal, N oder → weiter, E Schluss, 1–9 springen.
        Nur Form und Akkorde – Text und Melodie kommen von dir.
      </p>
      <% export = SongExport.new(@song) %>
      <p class="mt-2">
        <% if export.exported? %>
          Liegt in <code><%= export.dir %></code>.
        <% elsif @song.folder %>
          <code><%= export.dir %></code> ist von Hand übernommen und bleibt, wie es ist.
        <% else %>
          Noch nicht im Song-Ordner – liegt dort nach dem nächsten Speichern oder „Code neu bauen“.
        <% end %>
        <%= link_to "Song-Ordner ändern", settings_path, class: "underline" %>
      </p>
    </div>
    <div class="flex gap-3">
      <%= link_to "Bearbeiten", edit_song_path(@song), class: "ring-button" %>
      <%= button_to "Löschen", song_path(@song), method: :delete, class: "ring-button",
            form: {data: {turbo_confirm: "#{@song.display_title} wirklich löschen?"}} %>
      <%= button_to "Code neu bauen", song_code_path(@song), class: "ring-button",
            title: "Baut den Sonic-Pi-Code mit dem aktuellen Groove neu" %>
    </div>
  </div>
  </div>
<% end %>
