<% content_for :title, "#{@song.display_title} – mcblinded stage" %>
<%= turbo_stream_from @song %>

<% if @song.pending? %>
  <p class="eyebrow">Wird geschrieben …</p>
  <h1 class="mt-4 text-5xl leading-[1.05] font-semibold tracking-tight sm:text-7xl"><%= @song.request %></h1>
  <p class="mt-6 max-w-xl text-xl leading-relaxed text-muted">
    Tonart, Tempo und Akkorde werden gerade nachgeschlagen. Sobald sie da sind, startet das Play-Along von selbst.
  </p>
  <div class="mt-10 h-1 w-48 overflow-hidden rounded-full bg-ink/10">
    <div class="h-full w-1/3 animate-pulse rounded-full bg-accent"></div>
  </div>

<% elsif @song.failed? %>
  <p class="eyebrow">Hat nicht geklappt</p>
  <h1 class="mt-4 text-5xl font-semibold tracking-tight sm:text-7xl"><%= @song.request %></h1>
  <p class="mt-6 max-w-2xl rounded-2xl border-2 border-accent bg-accent/15 px-5 py-4 text-lg"><%= @song.error %></p>
  <%= link_to "← Anderen Song nennen", root_path, class: "ring-button mt-8" %>

<% else %>
  <% sheet = @song.lead_sheet %>
  <% primary = "ring-button bg-ink text-paper hover:!bg-accent hover:!border-accent hover:!text-accent-ink" %>
  <div data-controller="hotkeys">
  <div class="flex flex-wrap items-end justify-between gap-8">
    <div>
      <p class="eyebrow"><%= sheet.artist %></p>
      <h1 class="mt-3 text-5xl leading-[1.05] font-semibold tracking-tight sm:text-7xl"><%= sheet.title %></h1>
      <p class="mt-4 text-2xl text-muted">
        Tonart <span class="text-ink"><%= sheet.key %></span> · <span class="text-ink"><%= sheet.bpm %></span> bpm
      </p>
    </div>
    <div class="flex gap-3">
      <%= button_to song_playback_path(@song), class: primary, data: {hotkey: "p"} do %>
        ▶ Spielen
      <% end %>
      <%= button_to playback_path, method: :delete, class: "ring-button", data: {hotkey: "s escape"} do %>
        ■ Stopp
      <% end %>
    </div>
  </div>

  <%= turbo_stream_from @song, :now %>
  <section class="mt-10">
    <%= render "songs/now", now: NowPlaying.new(@song, nil) %>
    <div class="mt-4 flex flex-wrap items-center gap-3">
      <%= button_to song_command_path(@song, kind: "repeat"), class: "ring-button", data: {hotkey: "r"} do %>
        ↻ Teil wiederholen
      <% end %>
      <%= button_to song_command_path(@song, kind: "next"), class: "ring-button", data: {hotkey: "n arrowright"} do %>
        → Nächster Teil
      <% end %>
      <%= button_to song_command_path(@song, kind: "end"), class: "ring-button", data: {hotkey: "e"} do %>
        ⏏ Schluss
      <% end %>
      <p id="queued" class="text-lg" aria-live="polite"></p>
    </div>
  </section>

  <section class="mt-12">
    <h2 class="eyebrow">Ablauf – antippen springt dorthin</h2>
    <ol class="mt-3 flex flex-wrap gap-2">
      <% sheet.form.each_with_index do |name, i| %>
        <li>
          <%= button_to song_command_path(@song, kind: "jump", position: i), id: "form-#{i}",
                class: "rounded-full border-2 border-ink px-4 py-1 text-lg hover:border-accent",
                data: ({hotkey: (i + 1).to_s} if i < 9) do %>
            <%= name %>
          <% end %>
        </li>
      <% end %>
    </ol>
  </section>

  <section class="mt-12 grid gap-6 md:grid-cols-2">
    <% sheet.sections.each_with_index do |section, section_index| %>
      <article class="rounded-3xl border-2 border-ink bg-card p-5 sm:p-7">
        <h3 class="eyebrow"><%= section.name %></h3>
        <div class="mt-4 grid grid-cols-4 border-l-2 border-ink/30">
          <% position = 0 %>
          <% section.bars.each do |bar| %>
            <div class="flex min-w-0 flex-wrap items-baseline gap-x-2 border-r-2 border-ink/30 px-2 py-3 text-2xl font-semibold sm:px-3 xl:text-3xl">
              <% bar.each do |chord| %>
                <span id="chord-<%= section_index %>-<%= position %>"><%= chord %></span>
                <% position += 1 %>
              <% end %>
            </div>
          <% end %>
        </div>
      </article>
    <% end %>
  </section>

  <p class="mt-12 text-muted">
    Tasten: P spielen · S stopp · R wiederholen · N oder → weiter · E Schluss · 1–9 springen.
    Nur Form und Akkorde – Text und Melodie kommen von dir.
  </p>
  </div>
<% end %>
