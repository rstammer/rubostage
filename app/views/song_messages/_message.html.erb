<div id="<%= dom_id(message) %>" class="<%= message.user? ? "ml-8" : "mr-8" %>">
  <p class="eyebrow <%= "text-right" if message.user? %>"><%= message.user? ? "Du" : "Claude" %></p>
  <div class="mt-1 rounded px-3 py-2 text-lg leading-relaxed <%= message.user? ? "field" : "" %>"><%= simple_format(message.body, {}, wrapper_tag: "div") %></div>
</div>
