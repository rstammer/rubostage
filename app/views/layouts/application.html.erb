<!DOCTYPE html>
<html lang="de">
  <head>
    <title><%= content_for(:title) || "rubostage" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="application-name" content="rubostage">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= turbo_refreshes_with method: :morph, scroll: :preserve %>

    <%= yield :head %>

    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-screen" data-controller="theme">
    <header class="sticky top-0 z-40">
    <nav class="control-bar" aria-label="Kontrollleiste">
      <div class="flex items-center gap-x-6 gap-y-3 px-4 py-3 sm:px-6">
        <%= link_to root_path, class: "flex shrink-0 items-center gap-3" do %>
          <%= image_tag "logo.svg", alt: "", class: "h-11 w-auto drop-shadow" %>
          <span class="nameplate">rubostage</span>
        <% end %>
        <div class="min-w-0 flex-1">
          <%= render "controls/panel", panel: ControlPanel.new %>
        </div>
        <%= link_to "Einstellungen", settings_path, class: "panel-button shrink-0" %>
        <button type="button" class="flex shrink-0 items-center gap-2" data-action="theme#toggle"
                aria-label="Amp wechseln: Blonde (hell) oder Blackface (dunkel)">
          <span class="panel-label hidden sm:inline">Blonde</span>
          <span class="toggle" aria-hidden="true"></span>
          <span class="panel-label hidden sm:inline">Black</span>
        </button>
      </div>
    </nav>
    <%= render "controls/transport", panel: ControlPanel.new %>
    </header>

    <%# Below the bars, always three areas: songs and text on the left, the
        page in the middle, the chat on the right. Both sides draw in. %>
    <div class="workspace" data-controller="sidebars">
      <%= render "layouts/sidebar_left" %>
      <main class="workspace-main">
        <div class="mx-auto max-w-5xl">
          <% if flash[:notice] %>
            <p class="sheet mb-8 px-5 py-4 text-lg"><%= flash[:notice] %></p>
          <% end %>
          <% if flash[:alert] %>
            <p class="sheet mb-8 flex items-center gap-3 px-5 py-4 text-lg"><span class="lamp lamp-on" aria-hidden="true"></span><%= flash[:alert] %></p>
          <% end %>
          <%= yield %>
        </div>
      </main>
      <%= render "layouts/sidebar_right" %>
    </div>
  </body>
</html>
