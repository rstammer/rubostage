<!DOCTYPE html>
<html lang="de">
  <head>
    <title><%= content_for(:title) || "rubostage" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="application-name" content="rubostage">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= turbo_refreshes_with method: :morph, scroll: :preserve %>

    <%= yield :head %>

    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-screen" data-controller="theme">
    <header class="border-b-4 border-accent">
      <div class="mx-auto flex max-w-6xl items-center justify-between px-4 py-5 sm:px-8">
        <%= link_to root_path, class: "flex items-baseline gap-3" do %>
          <span class="text-2xl font-semibold tracking-tight sm:text-3xl">rubostage</span>
        <% end %>
        <button type="button" class="ring-button size-12 !p-0" data-action="theme#toggle" aria-label="Hell/Dunkel umschalten">
          <svg viewBox="0 0 24 24" class="size-6" aria-hidden="true">
            <circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="2"/>
            <path d="M12 3a9 9 0 0 1 0 18z" fill="currentColor"/>
          </svg>
        </button>
      </div>
    </header>

    <main class="mx-auto max-w-6xl px-4 py-10 sm:px-8 sm:py-16">
      <% if flash[:notice] %>
        <p class="mb-8 rounded-2xl border-2 border-ink/30 px-5 py-4 text-lg"><%= flash[:notice] %></p>
      <% end %>
      <% if flash[:alert] %>
        <p class="mb-8 rounded-2xl border-2 border-accent bg-accent/15 px-5 py-4 text-lg"><%= flash[:alert] %></p>
      <% end %>
      <%= yield %>
    </main>
  </body>
</html>
